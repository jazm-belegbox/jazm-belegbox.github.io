{
  "name": "Belegbox",
  "short_name": "Belegbox",
  "description": "Abos, Verträge, Geräte und Belege – verschlüsselt auf deinem Handy.",
  "lang": "de",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EDF1F0",
  "theme_color": "#0E6A5B",
  "categories": ["finance", "productivity"],
  "share_target": {
    "action": "./?teilen=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "files", "accept": ["application/pdf", ".pdf", "image/*"] }] }
  },
  "shortcuts": [
    { "name": "Beleg fotografieren", "short_name": "Foto", "url": "./?aktion=foto", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Neues Gerät", "short_name": "Gerät", "url": "./?aktion=geraet", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Neues Abo / Vertrag", "short_name": "Vertrag", "url": "./?aktion=vertrag", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Suchen", "short_name": "Suchen", "url": "./?aktion=suche", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
